# Copy to .env (chmod 600). Never commit .env.
# The controller's address on your network. Use its IP: mDNS names such as
# dgx-fans.local usually don't resolve inside Docker. Give the controller a
# fixed DHCP lease in your router so this doesn't change.
CONTROLLER_URL=http://192.168.1.50
# The controller's web page login (same as controller/.env USER / WEBPASS).
CONTROLLER_USER=fans
CONTROLLER_PASS=change-me
# Key agents send as X-API-Key on /mcp; generate with: openssl rand -hex 32
MCP_API_KEY=change-me
# Where the container listens on the host. The default is loopback only, for
# use behind a reverse proxy; set GX_RACK_BIND=0.0.0.0 to reach it directly
# from the LAN.
# GX_RACK_BIND=127.0.0.1
# GX_RACK_PORT=8096
