      "versionNonce": 736418144,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "LOLIN S3 (full size) — on/off switch and profile button.  Metal can up, USB sockets pointing at you.",
      "originalText": "LOLIN S3 (full size) — on/off switch and profile button.  Metal can up, USB sockets pointing at you.",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "s18",
      "type": "text",
      "x": 40,
      "y": -20,
      "width": 999.9000000000001,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 861878058,
      "version": 1,
      "versionNonce": 1040893146,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Probes and fans stay wired as they are (not drawn). Wires that cross WITHOUT a dot are not connected.",
      "originalText": "Probes and fans stay wired as they are (not drawn). Wires that cross WITHOUT a dot are not connected.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "s19",
      "type": "text",
      "x": 95,
      "y": 228,
      "width": 165.0,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 324479607,
      "version": 1,
      "versionNonce": 401383517,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "3V3\n= top LEFT hole",
      "originalText": "3V3\n= top LEFT hole",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "s20",
      "type": "text",
      "x": 300,
      "y": 1125,
      "width": 598.4000000000001,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 79756588,
      "version": 1,
      "versionNonce": 1009192786,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "+ goes to 3V3 (same supply as the probe and fan resistors) — NOT 5 V",
      "originalText": "+ goes to 3V3 (same supply as the probe and fan resistors) — NOT 5 V",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "s21",
      "type": "text",
      "x": 1080,
      "y": 560,
      "width": 475.20000000000005,
      "height": 337.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 504371160,
      "version": 1,
      "versionNonce": 160252398,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Three wires from the switch's cable:\n\n  D  →  pin 21\n        right edge, 3rd hole above the GND block\n        (between 47 and 14)\n  +  →  3V3   top LEFT hole   (not 5 V)\n  −  →  GND   (any GND hole)\n\nSwitch pressed in (lit)  =  fans ON\nSwitch out               =  fans OFF\n\nOff wins over every profile, except that a\nfan whose probe reaches 55 °C still runs.\nAfter a power cut the board follows\nwhatever position the switch is in.",
      "originalText": "Three wires from the switch's cable:\n\n  D  →  pin 21\n        right edge, 3rd hole above the GND block\n        (between 47 and 14)\n  +  →  3V3   top LEFT hole   (not 5 V)\n  −  →  GND   (any GND hole)\n\nSwitch pressed in (lit)  =  fans ON\nSwitch out               =  fans OFF\n\nOff wins over every profile, except that a\nfan whose probe reaches 55 °C still runs.\nAfter a power cut the board follows\nwhatever position the switch is in.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "s22",
      "type": "text",
      "x": -190,
      "y": 420,
      "width": 188.10000000000002,
      "height": 135.0,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 423864734,
      "version": 1,
      "versionNonce": 447883945,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Onboard RGB LED\nshows the profile:\n  green  Normal\n  blue   Quiet\n  red    Max\n  amber  switch off",
      "originalText": "Onboard RGB LED\nshows the profile:\n  green  Normal\n  blue   Quiet\n  red    Max\n  amber  switch off",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "s23",
      "type": "text",
      "x": -190,
      "y": 700,
      "width": 306.90000000000003,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 152314202,
      "version": 1,
      "versionNonce": 263019222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Button 0 on the board\n(the one that isn't RST):\n  single press → Normal ↔ Quiet\n  double press → Max ↔ Normal\n  long press (1 s) → Normal",
      "originalText": "Button 0 on the board\n(the one that isn't RST):\n  single press → Normal ↔ Quiet\n  double press → Max ↔ Normal\n  long press (1 s) → Normal",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
