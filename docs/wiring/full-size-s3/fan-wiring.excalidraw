  {
   "id": "e135",
   "type": "text",
   "x": 40,
   "y": 1240,
   "width": 574.2,
   "height": 270.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1036132969,
   "version": 1,
   "versionNonce": 227868237,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Five connections:\n\n1. pin 11 (left edge) → 100 Ω → fan blue          (blue)\n2. pin 13 (right edge) → 1 kΩ → fan green         (green)\n3. 10 kΩ from pin 13's side of the 1 kΩ → 3V3     (red)\n4. fan black → board GND  AND  supply −          (black)\n5. fan yellow → supply +                          (yellow)\n\n12 V goes ONLY to the fan's yellow wire —\nnever onto any hole of the board.\n\nSwitch the 12 V supply on last, keep USB plugged in.",
   "originalText": "Five connections:\n\n1. pin 11 (left edge) → 100 Ω → fan blue          (blue)\n2. pin 13 (right edge) → 1 kΩ → fan green         (green)\n3. 10 kΩ from pin 13's side of the 1 kΩ → 3V3     (red)\n4. fan black → board GND  AND  supply −          (black)\n5. fan yellow → supply +                          (yellow)\n\n12 V goes ONLY to the fan's yellow wire —\nnever onto any hole of the board.\n\nSwitch the 12 V supply on last, keep USB plugged in.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
 ],
