  {
   "id": "e109",
   "type": "text",
   "x": 700,
   "y": 560,
   "width": 638.0,
   "height": 325.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
