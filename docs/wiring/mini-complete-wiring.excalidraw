    {
      "id": "e274",
      "type": "text",
      "x": 460,
      "y": 1035,
      "width": 677.6,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1069206235,
      "version": 1,
      "versionNonce": 1043979109,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• The Mini runs from USB. The 12 V adapter feeds ONLY the fans' yellow wires.\n• 12 V must never touch any hole of the board.\n• The adapter's − and the board's GND are joined (GND rail) — required.\n• Check the adapter's + with a meter before connecting (DC, 12 V).\n• Switch the 12 V on last.",
      "originalText": "• The Mini runs from USB. The 12 V adapter feeds ONLY the fans' yellow wires.\n• 12 V must never touch any hole of the board.\n• The adapter's − and the board's GND are joined (GND rail) — required.\n• Check the adapter's + with a meter before connecting (DC, 12 V).\n• Switch the 12 V on last.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
